#!/bin/sh
set -eu

repo_dir=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
case "$(uname -s)" in
  Darwin) ;;
  *)
    printf '%s\n' \
      'Automatic account catalog refresh is supported only on macOS. Refresh the native Codex catalog with the Codex CLI for this platform, then rebuild the router catalog manually.' >&2
    exit 1
    ;;
esac

catalog_refresh_failed() {
  printf '%s\n' 'Catalog refresh failed; the previous catalog remains active.' >&2
  exit 1
}

if ! control_result=$("$repo_dir/bin/control" catalog-refresh 2>/dev/null); then
  catalog_refresh_failed
fi

case "$control_result" in
  '{"status":"updated","nativeModels":'*'}') refresh_status=updated ;;
  '{"status":"unchanged","nativeModels":'*'}') refresh_status=unchanged ;;
  '{"status":"skipped","nativeModels":'*'}') refresh_status=skipped ;;
  *) catalog_refresh_failed ;;
esac

result_prefix='{"status":"'"$refresh_status"'","nativeModels":'
native_models=${control_result#"$result_prefix"}
native_models=${native_models%?}
case "$native_models" in
  ''|*[!0-9]*) catalog_refresh_failed ;;
esac
case "$native_models" in
  0|[1-9]*) ;;
  *) catalog_refresh_failed ;;
esac

case "$refresh_status" in
  updated) printf '%s\n' 'Model catalog refreshed for the next Codex launch.' ;;
  unchanged) printf '%s\n' 'Model catalog is already current.' ;;
  skipped) printf '%s\n' 'Model catalog refresh skipped because Codex is signed out.' ;;
esac
